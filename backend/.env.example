ENVIRONMENT=development
DB_NAME=Professorsdb
DB_USER=local
DB_PASSWORD=replace-with-a-random-password
DB_ROOT_PASSWORD=replace-with-a-different-random-password
DB_PORT=3306
DATABASE_URL=mariadb+pymysql://local:replace-with-a-random-password@localhost:3306/Professorsdb?charset=utf8mb4
AUTH_PORT=8000
LOCAL_UID=1000
LOCAL_GID=1000
JWT_PRIVATE_KEY_FILE=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=.secrets/jwt-public.pem
JWT_ISSUER=professor-auth
JWT_AUDIENCE=professor-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
GOOGLE_CLIENT_ID=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
AUTH_REQUESTS_PER_MINUTE=30